{
  "expo": {
    "name": "Adidaya Preview",
    "slug": "adidaya-preview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-adidaya-black.png",
    "scheme": "adidaya-preview",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adidaya.preview",
      "icon": "./assets/images/logo-adidaya-black.png",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSLocationWhenInUseUsageDescription": "Allow Adidaya to verify your location for workplace attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Adidaya to verify your location for workplace attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-forma-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/logo-forma-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adidaya.preview",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo-adidaya-black.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Adidaya to access your photos.",
          "savePhotosPermission": "Allow Adidaya to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-forma-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Adidaya to use the camera for attendance face verification."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Forma to access your location to verify workplace attendance coordinates."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
